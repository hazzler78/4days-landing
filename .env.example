# Kopiera till .env.local för: vercel dev
# Lägg ALDRIG riktiga nycklar i git.

MAILERLITE_API_TOKEN=din_api_token_här
# Valfritt: hitta under Subscribers → Groups → Group ID i MailerLite
MAILERLITE_GROUP_ID=
# Separat grupp för Hermes one-click start (/gratis-guide-hermes-agenter)
# source: hermes-start (eller legacy hermes-guide)
MAILERLITE_HERMES_GROUP_ID=193416453376967920
# Nyhetsbrev "En dag mer". Lägg till på alla anmälningar, utöver guide/Hermes.
# Tomt eller utelämnat faller tillbaka på 204098412960810629.
MAILERLITE_NEWSLETTER_GROUP_ID=204098412960810629
# Grupp "Webbinar" för påminnelser från /webbinar (source: webbinar).
# Skapa gruppen i MailerLite (Subscribers → Groups → Group ID) och klistra in id:t.
# Sätt samma värde i Vercel för Preview och Production. Skapa inget via API här.
# Tomt: anmälan sparas ändå (nyhetsbrev + fältet tags=webbinar) men inte i en egen grupp.
MAILERLITE_WEBINAR_GROUP_ID=

# ─── 4days.ai Agent (chatbot) ───────────────────────────────────────────────
XAI_API_KEY=xai-...
# Valfritt: grok-3-mini (standard), grok-3, grok-2-latest
# XAI_MODEL=grok-3-mini

# Embeddings för Supabase RAG (kunskapsbas)
OPENAI_API_KEY=sk-...

# Supabase – service role för RAG (aldrig i frontend!)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Valfritt alias (chat.js läser båda)
# SUPABASE_URL=https://xxx.supabase.co

CALENDLY_URL=https://calendly.com/hello-4days/30min

# ─── IndexNow (Bing m.fl.) ───────────────────────────────────────────────────
# API-nyckel från https://www.bing.com/indexnow/getstarted
# Lägg samma värde i Vercel → Settings → Environment Variables (Production).
# Vid deploy skapas automatiskt filen https://www.4days.ai/{API_KEY}.txt
INDEXNOW_API_KEY=din_indexnow_nyckel_här
# Valfritt – standard är www.4days.ai
# INDEXNOW_HOST=www.4days.ai
# Valfritt – skyddar POST /api/indexnow (rekommenderat)
# INDEXNOW_SUBMIT_SECRET=ett_långt_hemligt_värde
